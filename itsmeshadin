/**
 * Trader Shadin X — Fixed Direct Image URL & Instant Tap Response
 * Paste entire file into DevTools Console (F12) on the trading platform page.
 */
(function () {
  if (window.__TRADER_SHADIN_X_ACTIVE__) {
    console.warn("Trader Shadin X already running.");
    return;
  }

  function initTraderShadinX() {
    window.__TRADER_SHADIN_X_ACTIVE__ = true;

    const LOGO_URL = "https://i.postimg.cc/90G8p42X/image-642a6e.jpg";
    const LABEL = "Trader Shadin X";
    const STORAGE_KEY = "trader_shadin_x_settings_v8";
    const TAP_REQUIRED = 3;
    const TAP_SETTLE_MS = 120;
    const TAP_SEQUENCE_MS = 500;

    const defaults = { delaySec: 0, direction: "random" };

    function parseStored(raw) {
      if (!raw) return null;
      const s = JSON.parse(raw);
      const delaySec = Math.max(0, Math.min(30, Number(s.delaySec) || defaults.delaySec));
      const direction = ["up", "down", "random"].includes(s.direction)
        ? s.direction
        : defaults.direction;
      return { delaySec, direction };
    }

    function loadSettings() {
      const sources = [
        () => localStorage.getItem(STORAGE_KEY),
        () => sessionStorage.getItem(STORAGE_KEY),
        () => {
          const b = window.__TRADER_SHADIN_X_SETTINGS_BACKUP__;
          return b ? JSON.stringify(b) : null;
        },
      ];
      for (const get of sources) {
        try {
          const parsed = parseStored(get());
          if (parsed) return parsed;
        } catch {
          /* try next */
        }
      }
      return { ...defaults };
    }

    function saveSettings(s) {
      const json = JSON.stringify(s);
      window.__TRADER_SHADIN_X_SETTINGS_BACKUP__ = { ...s };
      let ok = false;
      try {
        localStorage.setItem(STORAGE_KEY, json);
        ok = true;
      } catch {
        /* blocked */
      }
      try {
        sessionStorage.setItem(STORAGE_KEY, json);
        ok = true;
      } catch {
        /* blocked */
      }
      return ok;
    }

    let settings = loadSettings();

    const style = document.createElement("style");
    style.textContent = `
      #tsx-widget {
        position: fixed;
        z-index: 2147483646;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        cursor: grab;
        touch-action: none;
        user-select: none;
        -webkit-user-select: none;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        filter: drop-shadow(0 2px 5px rgba(0,0,0,0.5));
        transition: filter 0.25s ease;
      }
      #tsx-widget.tsx-glow {
        filter: drop-shadow(0 0 8px #9400ff) drop-shadow(0 0 18px #9400ff)
          drop-shadow(0 0 30px rgba(148,0,255,0.6));
      }
      #tsx-widget:active { cursor: grabbing; }
      #tsx-logo-wrap {
        width: 38px;
        height: 38px;
        min-width: 38px;
        min-height: 38px;
        border-radius: 50%;
        overflow: hidden;
        background: rgba(0,0,0,0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
      }
      #tsx-logo-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        pointer-events: none;
      }
      #tsx-label {
        font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.03em;
        color: #fff;
        text-shadow: 0 1px 3px rgba(0,0,0,0.85);
        pointer-events: none;
        white-space: nowrap;
        text-align: center;
      }
      #tsx-widget.tsx-glow #tsx-label {
        color: #e2b8ff;
        text-shadow: 0 0 5px #9400ff, 0 0 10px #9400ff;
      }
      #tsx-scan-overlay {
        position: fixed;
        inset: 0;
        z-index: 2147483645;
        pointer-events: none;
        overflow: hidden;
        display: none;
      }
      #tsx-scan-overlay.tsx-scan-on { display: block; }
      #tsx-scan-line {
        position: absolute;
        left: 0;
        width: 100%;
        height: 5px;
        background: linear-gradient(
          180deg,
          #3ad67f 0%,
          #22c464 16%,
          #14ad56 40%,
          #009e4a 58%,
          #008a40 82%,
          rgba(0, 110, 48, 0.55) 100%
        );
        box-shadow:
          0 -88px 130px rgba(0, 220, 115, 1),
          0 -68px 100px rgba(0, 200, 100, 1),
          0 -50px 78px rgba(0, 185, 92, 0.98),
          0 -34px 58px rgba(0, 170, 85, 0.96),
          0 -22px 40px rgba(0, 155, 78, 0.94),
          0 -12px 26px rgba(0, 140, 72, 0.9),
          0 -6px 14px rgba(0, 125, 65, 0.88),
          0 0 28px rgba(0, 150, 75, 0.85),
          0 0 55px rgba(0, 130, 65, 0.55);
        top: -8%;
      }
      #tsx-scan-line.tsx-animate-sweep {
        animation: tsx-scan-move 1.2s linear 1;
      }
      @keyframes tsx-scan-move {
        0% { top: -8%; }
        100% { top: 108%; }
      }
      #tsx-panel {
        position: fixed;
        z-index: 2147483647;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        opacity: 0;
        pointer-events: none;
        width: min(300px, calc(100vw - 32px));
        padding: 18px 16px 14px;
        border-radius: 14px;
        background: linear-gradient(160deg, #150d1f 0%, #0a0c0f 100%);
        border: 1px solid rgba(148,0,255,0.35);
        box-shadow: 0 0 40px rgba(148,0,255,0.25), 0 12px 40px rgba(0,0,0,0.55);
        font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        color: #f3e8ff;
      }
      #tsx-panel.tsx-panel-open {
        opacity: 1;
        pointer-events: auto;
      }
      #tsx-panel h3 {
        margin: 0 0 14px;
        font-size: 16px;
        font-weight: 700;
        text-align: center;
        color: #b066ff;
        letter-spacing: 0.06em;
      }
      #tsx-panel .tsx-row {
        margin-bottom: 14px;
      }
      #tsx-panel label {
        display: block;
        font-size: 12px;
        color: #d2b4ed;
        margin-bottom: 6px;
      }
      #tsx-panel .tsx-input-block {
        display: block;
        width: 100%;
      }
      #tsx-panel .tsx-time-input {
        box-sizing: border-box;
        width: 100%;
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid rgba(148,0,255,0.3);
        background: rgba(0,0,0,0.35);
        color: #fff;
        font-size: 15px;
        font-family: inherit;
        outline: none;
        -webkit-appearance: none;
        appearance: none;
      }
      #tsx-panel .tsx-time-input:focus {
        border-color: #b066ff;
        box-shadow: 0 0 0 2px rgba(148,0,255,0.2);
      }
      #tsx-panel .tsx-save-btn {
        flex-shrink: 0;
        padding: 10px 14px;
        border: none;
        border-radius: 8px;
        background: #b066ff;
        color: #1a0522;
        font-weight: 700;
        font-size: 13px;
        font-family: inherit;
        cursor: pointer;
      }
      #tsx-panel .tsx-save-btn-block {
        display: block;
        width: 100%;
        margin-top: 4px;
        padding: 12px 14px;
        font-size: 14px;
      }
      #tsx-dir-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      #tsx-dir-group button {
        padding: 11px 12px;
        border-radius: 8px;
        border: 1px solid rgba(148,0,255,0.25);
        background: rgba(0,0,0,0.3);
        color: #f3e8ff;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
      }
      #tsx-dir-group button.tsx-dir-active {
        background: rgba(148,0,255,0.18);
        border-color: #b066ff;
        box-shadow: 0 0 16px rgba(148,0,255,0.35);
        color: #b066ff;
      }
      #tsx-panel-backdrop {
        position: fixed;
        inset: 0;
        z-index: 2147483646;
        background: rgba(0, 0, 0, 0.5);
        opacity: 0;
        pointer-events: none;
      }
      #tsx-panel-backdrop.tsx-backdrop-open {
        opacity: 1;
        pointer-events: auto;
      }
      #tsx-panel-hint {
        margin: 10px 0 0;
        font-size: 11px;
        text-align: center;
        color: #a485c2;
        line-height: 1.35;
      }
      #tsx-save-status {
        min-height: 18px;
        margin: 8px 0 0;
        font-size: 12px;
        text-align: center;
        color: #b066ff;
        font-weight: 600;
      }
      #tsx-panel button,
      #tsx-panel input {
        touch-action: manipulation;
      }
    `;
    document.head.appendChild(style);

    const scanOverlay = document.createElement("div");
    scanOverlay.id = "tsx-scan-overlay";
    scanOverlay.innerHTML = '<div id="tsx-scan-line"></div>';
    document.body.appendChild(scanOverlay);

    const scanLine = scanOverlay.querySelector("#tsx-scan-line");

    const backdrop = document.createElement("div");
    backdrop.id = "tsx-panel-backdrop";

    const panel = document.createElement("div");
    panel.id = "tsx-panel";
    panel.innerHTML = `
      <h3>Trader Shadin X Settings</h3>
      <div class="tsx-row">
        <label>Start delay (seconds)</label>
        <input id="tsx-delay-input" class="tsx-time-input tsx-input-block" type="number" min="0" max="30" step="1" />
      </div>
      <div class="tsx-row">
        <label>Trade direction</label>
        <div id="tsx-dir-group">
          <button type="button" data-dir="up">Up</button>
          <button type="button" data-dir="down">Down</button>
          <button type="button" data-dir="random">Random</button>
        </div>
      </div>
      <button type="button" id="tsx-save-all" class="tsx-save-btn tsx-save-btn-block">Save</button>
      <p id="tsx-save-status"></p>
      <p id="tsx-panel-hint">3 taps on icon to open · tap outside to close</p>
    `;
    document.body.appendChild(backdrop);
    document.body.appendChild(panel);

    panel.addEventListener("mousedown", (e) => e.stopPropagation());
    panel.addEventListener("touchstart", (e) => e.stopPropagation(), { passive: true });
    panel.addEventListener("touchend", (e) => e.stopPropagation());

    const delayInput = panel.querySelector("#tsx-delay-input");
    const saveStatus = panel.querySelector("#tsx-save-status");
    const dirButtons = panel.querySelectorAll("#tsx-dir-group button");
    let pendingDirection = settings.direction;

    function syncDirectionUI(dir) {
      dirButtons.forEach((btn) => {
        btn.classList.toggle("tsx-dir-active", btn.dataset.dir === dir);
      });
    }

    function syncPanelUI() {
      delayInput.value = String(settings.delaySec);
      pendingDirection = settings.direction;
      syncDirectionUI(pendingDirection);
    }

    function openPanel() {
      syncPanelUI();
      backdrop.classList.add("tsx-backdrop-open");
      panel.classList.add("tsx-panel-open");
    }

    function closePanel() {
      backdrop.classList.remove("tsx-backdrop-open");
      panel.classList.remove("tsx-panel-open");
      saveStatus.textContent = "";
    }

    function applyAllSettings() {
      const n = Number(String(delayInput.value).trim());
      settings.delaySec = Number.isFinite(n) ? Math.max(0, Math.min(30, Math.round(n))) : defaults.delaySec;
      settings.direction = pendingDirection;
      delayInput.value = String(settings.delaySec);
      saveSettings(settings);
      syncPanelUI();
      closePanel();
    }

    function bindPanelAction(el, handler) {
      let lock = false;
      const run = (e) => {
        if (e.cancelable) e.preventDefault();
        e.stopPropagation();
        if (lock) return;
        lock = true;
        setTimeout(() => {
          lock = false;
        }, 300);
        handler();
      };
      el.addEventListener("pointerup", run);
      el.addEventListener("click", run);
    }

    bindPanelAction(panel.querySelector("#tsx-save-all"), applyAllSettings);
    delayInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        applyAllSettings();
      }
    });

    dirButtons.forEach((btn) => {
      bindPanelAction(btn, () => {
        pendingDirection = btn.dataset.dir;
        syncDirectionUI(pendingDirection);
      });
    });

    bindPanelAction(backdrop, closePanel);

    const widget = document.createElement("div");
    widget.id = "tsx-widget";
    widget.innerHTML = `
      <div id="tsx-logo-wrap"><img src="${LOGO_URL}" alt="Trader Shadin X" draggable="false" /></div>
      <span id="tsx-label">${LABEL}</span>
    `;
    document.body.appendChild(widget);

    let scanActive = false;
    let mainTimer = null;
    let tapCount = 0;
    let tapSettleTimer = null;
    let lastTapAt = 0;

    function getTradeButtons() {
      const root = document.getElementById("trade-button");
      if (!root) return { up: null, down: null };
      return {
        up: root.querySelector("button.JQZcs"),
        down: root.querySelector("button.twQq3"),
      };
    }

    function pickTradeButton() {
      const { up, down } = getTradeButtons();
      if (!up && !down) return null;
      if (settings.direction === "up") return up || null;
      if (settings.direction === "down") return down || null;
      const pool = [up, down].filter(Boolean);
      return pool[Math.floor(Math.random() * pool.length)];
    }

    function placeTrade() {
      const btn = pickTradeButton();
      if (btn) btn.click();
    }

    function stopScanSession() {
      widget.classList.remove("tsx-glow");
      scanOverlay.classList.remove("tsx-scan-on");
      scanLine.classList.remove("tsx-animate-sweep");
      scanActive = false;
      if (mainTimer) {
        clearTimeout(mainTimer);
        mainTimer = null;
      }
    }

    function startAutoTradeWorkflow() {
      if (scanActive) return;
      closePanel();
      scanActive = true;
      widget.classList.add("tsx-glow");
      scanOverlay.classList.add("tsx-scan-on");

      const delayMs = settings.delaySec * 1000;
      const sweepDurationMs = 1200;
      const totalSweeps = 3;

      mainTimer = setTimeout(() => {
        if (!scanActive) return;

        let currentSweep = 0;

        function runNextSweep() {
          if (!scanActive) return;

          if (currentSweep < totalSweeps) {
            currentSweep++;
            scanLine.classList.remove("tsx-animate-sweep");
            void scanLine.offsetWidth;
            scanLine.classList.add("tsx-animate-sweep");

            mainTimer = setTimeout(runNextSweep, sweepDurationMs);
          } else {
            placeTrade();
            stopScanSession();
          }
        }

        runNextSweep();
      }, delayMs);
    }

    function resetTapCounter() {
      tapCount = 0;
      if (tapSettleTimer) {
        clearTimeout(tapSettleTimer);
        tapSettleTimer = null;
      }
    }

    function registerTap() {
      if (panel.classList.contains("tsx-panel-open")) return;

      const now = Date.now();
      if (now - lastTapAt > TAP_SEQUENCE_MS) tapCount = 0;
      lastTapAt = now;
      tapCount += 1;

      if (tapSettleTimer) {
        clearTimeout(tapSettleTimer);
        tapSettleTimer = null;
      }

      if (tapCount >= TAP_REQUIRED) {
        resetTapCounter();
        openPanel();
        return;
      }

      tapSettleTimer = setTimeout(() => {
        tapSettleTimer = null;
        if (tapCount === 1) {
          if (scanActive) {
            stopScanSession();
          } else {
            startAutoTradeWorkflow();
          }
        }
        tapCount = 0;
      }, TAP_SETTLE_MS);
    }

    let dragging = false;
    let moved = false;
    let startX = 0;
    let startY = 0;
    let startLeft = 0;
    let startTop = 0;
    const DRAG_THRESHOLD = 8;

    function clampPosition(left, top) {
      const rect = widget.getBoundingClientRect();
      const maxL = window.innerWidth - rect.width;
      const maxT = window.innerHeight - rect.height;
      return {
        left: Math.max(0, Math.min(left, maxL)),
        top: Math.max(0, Math.min(top, maxT)),
      };
    }

    function onPointerDown(clientX, clientY) {
      dragging = true;
      moved = false;
      const r = widget.getBoundingClientRect();
      startX = clientX;
      startY = clientY;
      startLeft = r.left;
      startTop = r.top;
      widget.style.transform = "none";
      widget.style.left = startLeft + "px";
      widget.style.top = startTop + "px";
    }

    function onPointerMove(clientX, clientY) {
      if (!dragging) return;
      const dx = clientX - startX;
      const dy = clientY - startY;
      if (Math.abs(dx) > DRAG_THRESHOLD || Math.abs(dy) > DRAG_THRESHOLD) {
        moved = true;
      }
      const pos = clampPosition(startLeft + dx, startTop + dy);
      widget.style.left = pos.left + "px";
      widget.style.top = pos.top + "px";
    }

    function onPointerUp() {
      if (!dragging) return;
      dragging = false;
      if (!moved) registerTap();
    }

    widget.addEventListener("mousedown", (e) => {
      e.preventDefault();
      onPointerDown(e.clientX, e.clientY);
    });

    widget.addEventListener(
      "touchstart",
      (e) => {
        if (e.touches.length !== 1) return;
        e.preventDefault();
        const t = e.touches[0];
        onPointerDown(t.clientX, t.clientY);
      },
      { passive: false }
    );

    document.addEventListener("mousemove", (e) => onPointerMove(e.clientX, e.clientY));
    document.addEventListener(
      "touchmove",
      (e) => {
        if (!dragging || e.touches.length !== 1) return;
        e.preventDefault();
        const t = e.touches[0];
        onPointerMove(t.clientX, t.clientY);
      },
      { passive: false }
    );

    document.addEventListener("mouseup", onPointerUp);
    document.addEventListener("touchend", onPointerUp);
    document.addEventListener("touchcancel", onPointerUp);

    window.__TRADER_SHADIN_X_STOP__ = function () {
      stopScanSession();
      resetTapCounter();
      closePanel();
      widget.remove();
      scanOverlay.remove();
      backdrop.remove();
      panel.remove();
      style.remove();
      delete window.__TRADER_SHADIN_X_ACTIVE__;
      delete window.__TRADER_SHADIN_X_STOP__;
    };

    syncPanelUI();
  }

  initTraderShadinX();
})();
